FROM spotlight-planner:20261020-inventory-r20c
WORKDIR /app
# Refuse to replace a backend that differs from the inspected production version.
RUN node -e "const fs=require('fs'),c=require('crypto');if(c.createHash('sha256').update(fs.readFileSync('app/api/app/route.ts')).digest('hex')!=='458ca8fc9b4e6c26f114ee26f3bb7f33dfb620758d44b73f381bfa1099368205')throw Error('Backend source changed; review before deployment')"
COPY app/page.tsx app/InventoryTable.tsx app/InventoryBulkEdit.tsx app/inventory-bulk.mjs app/inventory-workspace.css ./app/
COPY app/api/app/route.ts ./app/api/app/
COPY tests/inventory-bulk.test.mjs ./tests/
RUN npm test && node --test tests/planner-ui.test.mjs tests/planning-store.test.mjs tests/planning-decision.test.mjs tests/planning-decision-ui.test.mjs tests/planning-demographics.test.mjs tests/map-symbols.test.mjs tests/planning-budget.test.mjs tests/inventory-workflow.test.mjs tests/inventory-bulk.test.mjs && npm run build && tar -C public --exclude=downloads -cf - . | tar -C dist/client -xf -
